{
  "description": "Shared engineering workflow hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/migration-generator.sh\" codex \"$(git rev-parse --show-toplevel)\"",
            "timeout": 10,
            "statusMessage": "Checking migration creation"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/play-sound.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
