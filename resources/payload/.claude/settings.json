{
  "includeCoAuthoredBy": false,
  "includeGitInstructions": true,
  "permissions": {
    "allow": [],
    "deny": [
      "Read(auth.json)",
      "Read(**/auth.json)",
      "Read(storage/oauth-*.key)",
      "Read(**/storage/oauth-*.key)",
      "Read(storage/*.key)",
      "Read(**/storage/*.key)",
      "Read(*secrets*)",
      "Read(**/*secrets*)",
      "Read(*credential*)",
      "Read(**/*credential*)",
      "Read(*credentials*)",
      "Read(**/*credentials*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(auth.json)",
      "Edit(**/auth.json)",
      "Edit(storage/*.key)",
      "Edit(**/storage/*.key)",
      "Edit(*secret*)",
      "Edit(**/*secret*)",
      "Edit(*credential*)",
      "Edit(**/*credential*)"
    ],
    "defaultMode": "auto",
    "ask": [
      "Bash(aws:*)",
      "Bash(git push:*)"
    ]
  },
  "model": "opus",
  "disableClaudeAiConnectors": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.agents/hooks/migration-generator.sh\" claude \"$CLAUDE_PROJECT_DIR\"",
            "if": "Write(**/database/migrations/**)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.agents/hooks/play-sound.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/statusline.sh\""
  },
  "enabledPlugins": {
    "php-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "outputStyle": "efficient",
  "preferredNotifChannel": "notifications_disabled",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": false,
  "autoConnectIde": true,
  "effortLevel": "xhigh"
}
