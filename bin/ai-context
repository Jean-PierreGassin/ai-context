#!/usr/bin/env bash
set -euo pipefail

unset CDPATH
repository_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
readonly repository_root
caller_dir="$(pwd)"
use_task=true

if [[ "${1:-}" == --task-run ]]; then
  use_task=false
  shift
fi
if [[ "${1:-}" == --caller-dir ]]; then
  [[ $# -ge 2 ]] || { printf 'ai-context: --caller-dir requires a path\n' >&2; exit 1; }
  caller_dir="$2"
  shift 2
fi
readonly caller_dir use_task

usage() {
  cat <<'EOF'
ai-context

Usage:
  ai-context install [--project | --global] [--force] [--replace-config] [--dry-run] [--verbose] [--no-interaction]
  ai-context doctor [--project | --global]
  ai-context history [--project | --global]
  ai-context rollback [snapshot] [--project | --global]
  ai-context help [command]

Install targets the current project by default. Existing configuration is merged,
packaged skills are updated, and other changed managed files require confirmation
unless --force is supplied.
EOF
}

usage_command() {
  case "$1" in
    install)
      cat <<'EOF'
Usage: ai-context install [--project | --global] [--force] [--replace-config] [--dry-run] [--verbose] [--no-interaction]

Install managed instructions, skills, hooks, and agent configuration. Project
configuration is the default. Packaged skills are always updated to the bundled
version. The command shows its plan and asks for approval before it saves a
rollback snapshot or writes files.

Options:
  --project           Update the current project
  --global            Update global configuration
  --force, -f         Replace changed managed files outside packaged skills
  --replace-config    Replace structured configuration instead of merging it
  --dry-run           Show changes without writing files or saving a snapshot
  --verbose           List every path in the installation preview
  --no-interaction    Run without confirmation prompts
EOF
      ;;
    doctor)
      cat <<'EOF'
Usage: ai-context doctor [--project | --global]

Check required tools, managed files, instruction imports, and configuration
syntax. Project configuration is the default. Optional tools produce warnings.
EOF
      ;;
    history)
      cat <<'EOF'
Usage: ai-context history [--project | --global]

List saved pre-action states for the selected target. Each row states how many
paths a rollback will restore and how many newly installed paths it will remove.
Project history is the default and is separate from global history.
EOF
      ;;
    rollback)
      cat <<'EOF'
Usage: ai-context rollback [snapshot] [--project | --global]

Restore a saved pre-action state. Without a snapshot ID, an interactive terminal
shows a selector. A non-interactive terminal restores the latest snapshot.
Rollback saves the current state first, so another rollback can undo the action.
EOF
      ;;
    *) fail "unknown help topic: $1" ;;
  esac
}

fail() {
  printf 'ai-context: %s\n' "$1" >&2
  exit 1
}

command_name="${1:-help}"
if [[ $# -gt 0 ]]; then
  shift
fi
command_arguments=()
if [[ $# -gt 0 ]]; then
  command_arguments=("$@")
fi
readonly -a command_arguments

case "$command_name" in
  help)
    if [[ $# -eq 0 ]]; then
      usage
    elif [[ $# -eq 1 ]]; then
      usage_command "$1"
    else
      fail 'help accepts one command name'
    fi
    exit 0
    ;;
  -h|--help)
    usage
    exit 0
    ;;
  install|doctor|history|rollback) ;;
  *) fail "unknown command: $command_name" ;;
esac

scope=project
selected_scope=
force=false
dry_run=false
interactive=true
replace_config=false
verbose=false
snapshot_id=

while [[ $# -gt 0 ]]; do
  case "$1" in
    --project)
      [[ -z "$selected_scope" || "$selected_scope" == project ]] || fail "choose either --project or --global"
      scope=project
      selected_scope=project
      ;;
    --global)
      [[ -z "$selected_scope" || "$selected_scope" == global ]] || fail "choose either --project or --global"
      scope=global
      selected_scope=global
      ;;
    --force|-f) force=true ;;
    --replace-config) replace_config=true ;;
    --dry-run) dry_run=true ;;
    --verbose) verbose=true ;;
    --no-interaction|-n) interactive=false ;;
    help|-h|--help)
      usage_command "$command_name"
      exit 0
      ;;
    *)
      if [[ "$command_name" == rollback && "$1" != -* && -z "$snapshot_id" ]]; then
        snapshot_id="$1"
      else
        fail "unknown option: $1"
      fi
      ;;
  esac
  shift
done

if [[ "$command_name" != install \
  && ("$force" == true || "$replace_config" == true || "$dry_run" == true || "$verbose" == true || "$interactive" == false) ]]; then
  fail "$command_name accepts only a scope and, for rollback, an optional snapshot"
fi

if [[ "$use_task" == true ]] && command -v task >/dev/null 2>&1; then
  task_sentinel_root="$(mktemp -d "${TMPDIR:-/tmp}/ai-context-task.XXXXXX")"
  task_sentinel="$task_sentinel_root/started"
  task_invocation=(task --silent --taskfile "$repository_root/Taskfile.dist.yml" --dir "$repository_root" \
    "$command_name" "CALLER_DIR=$caller_dir" "TASK_SENTINEL=$task_sentinel")
  if [[ ${#command_arguments[@]} -gt 0 ]]; then
    task_invocation+=(-- "${command_arguments[@]}")
  fi
  if "${task_invocation[@]}"; then
    rm -rf "$task_sentinel_root"
    exit 0
  else
    task_status=$?
  fi
  if [[ -e "$task_sentinel" ]]; then
    rm -rf "$task_sentinel_root"
    exit "$task_status"
  fi
  rm -rf "$task_sentinel_root"
  printf 'ai-context: Task could not start the command; using the shell fallback.\n' >&2
fi

case "$command_name" in
  install)
    exec "$repository_root/scripts/install.sh" \
      "$scope" "$caller_dir" "$force" "$dry_run" "$interactive" "$replace_config" "$verbose"
    ;;
  doctor|history)
    exec "$repository_root/scripts/$command_name.sh" "$scope" "$caller_dir"
    ;;
  rollback)
    exec "$repository_root/scripts/rollback.sh" "$scope" "$caller_dir" "$snapshot_id" "$interactive"
    ;;
esac
